# Copy this file to .env and fill in real values. .env is gitignored.
# Values are inlined into the JS bundle at build time (react-native-dotenv),
# so never put anything here that shouldn't ship inside the app binary.

# Which environment this app is running in. Must be one of: local, stg, prod
APP_ENV=local

# Base URL the app uses to reach the backend API
API_BASE_URL=http://localhost:8000

# Secret available for signing/encrypting locally-persisted data
SESSION_SECRET=change-me

# Minimum log level emitted by the logger: debug | info | warn | error
LOG_LEVEL=info
